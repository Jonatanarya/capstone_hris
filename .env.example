# PeopleSpace HRIS — konfigurasi Supabase.
# Salin ke .env (atau .env.local). Berkas ini di-ignore Git. Jangan commit rahasia.
#
# PENTING — bedakan dua jenis "key" yang berbeda:
#
#   1. Access Token akun  (sbp_...) — ada di supabase.com/dashboard/account/tokens
#      Ini untuk CLI (`supabase login`) & Management API. BUKAN untuk aplikasi.
#      JANGAN taruh sbp_... di SUPABASE_SERVICE_ROLE_KEY.
#
#   2. API Keys project   — ada di Dashboard → Project → Settings → API Keys
#      (atau tombol hijau "Connect" pada project). Ini yang dipakai aplikasi:
#        - Publishable key  sb_publishable_...   → aman untuk browser
#        - Secret key       sb_secret_...        → hanya server
#      Di tab "Legacy API keys" versinya JWT: `anon` dan `service_role`.

# Project URL (aman dipakai di browser). Contoh: https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (aman dipakai di browser). Mendukung nama baru (publishable)
# maupun nama lama (anon) agar kompatibel dengan SDK.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (atau service_role legacy). HANYA dipakai di server (operasi admin).
# Jangan memberi prefix NEXT_PUBLIC dan jangan pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: untuk perintah Supabase CLI (login). Bukan dipakai aplikasi runtime.
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxx